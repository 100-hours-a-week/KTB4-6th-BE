# 이 파일을 복사해서 .env 로 만들고 실제 값을 채워주세요
# cp .env.example .env

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3307
DB_NAME=meety
DB_USERNAME=root
DB_PASSWORD=

# OAuth2 - Kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
KAKAO_ADMIN_KEY=

# JWT
JWT_SECRET=

# CORS (쉼표로 구분, 브라우저가 직접 호출하는 프론트 Origin)
CORS_ALLOWED_ORIGINS=http://localhost:3000
