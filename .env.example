# 이 파일을 복사해서 .env 로 만들고 실제 값을 채워주세요
# cp .env.example .env

# Spring Profile
SPRING_PROFILES_ACTIVE=local

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3307
DB_NAME=meety
DB_USERNAME=root
DB_PASSWORD=meety

# Meeting
MEETING_DAILY_CREATE_LIMIT=5

# Credit
CREDIT_MAX_BALANCE=1000
CREDIT_TEAM_CREATE_GRANT=200
CREDIT_WEEKLY_GRANT=200
CREDIT_WEEKLY_GRANT_CRON=0 0 0 * * MON
CREDIT_RECORDING_COST=20
CREDIT_SUMMARY_REGENERATE_COST=3
CREDIT_AI_CHAT_MESSAGE_COST=1
CREDIT_ANALYSIS_REPORT_COST=5

# OAuth2 - Kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
KAKAO_ADMIN_KEY=

# JWT
JWT_SECRET=

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_SEND_DEFAULT_PII=false
SENTRY_LOGS_ENABLED=false
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILE_SESSION_SAMPLE_RATE=0.0
SENTRY_PROFILE_LIFECYCLE=TRACE
SENTRY_AUTH_TOKEN=

# AWS S3
AWS_S3_BUCKET=meety-local
AWS_S3_REGION=us-east-2

# AWS 자격 증명 (EC2 IAM Role을 쓰면 비워둔다)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AI 서버 (live: 실시간 전사 WebSocket / analysis: 요약 등 HTTP API — 서로 다른 서비스)
AI_WEBSOCKET_URL=ws://localhost:8000/v1/live-meeting
AI_HTTP_URL=http://localhost:8001

# AI 서버가 BE 내부 조회 API(/internal/**)를 호출할 때 쓰는 공유 키 (비어 있으면 내부 API 전부 401)
INTERNAL_API_KEY=

# CORS (쉼표로 구분, 브라우저가 직접 호출하는 프론트 Origin)
CORS_ALLOWED_ORIGINS=http://localhost:3000
