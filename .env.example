# 이 파일을 복사해서 .env 로 만들고 실제 값을 채워주세요
# cp .env.example .env

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3307
DB_NAME=meety
DB_USERNAME=root
DB_PASSWORD=

# OAuth2 - Kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
KAKAO_ADMIN_KEY=

# JWT
JWT_SECRET=

# AWS S3
AWS_S3_BUCKET=meety-file-bucket-062270568040-us-east-2-an
AWS_S3_REGION=us-east-2

# AWS 자격 증명 (EC2 IAM Role을 쓰면 비워둔다)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AI 서버 (live: 실시간 전사 WebSocket / analysis: 요약 등 HTTP API — 서로 다른 서비스)
AI_WEBSOCKET_URL=ws://localhost:8000/v1/live-meeting
AI_HTTP_URL=http://localhost:8001

# CORS (쉼표로 구분, 브라우저가 직접 호출하는 프론트 Origin)
CORS_ALLOWED_ORIGINS=http://localhost:3000
